{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "piti-online",
  "main": "worker.js",
  "compatibility_date": "2026-09-17",
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
